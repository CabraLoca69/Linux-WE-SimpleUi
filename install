#!/bin/bash
# Install wallpaper-engine-picker

BIN="$HOME/.local/bin"
CONFIG_DIR="$HOME/.config/wallpaperengine"

mkdir -p "$BIN" "$CONFIG_DIR"

cp wallpaper-picker "$BIN/wallpaper-picker"
cp wallpaper-on-start "$BIN/wallpaper-on-start"
chmod +x "$BIN/wallpaper-picker" "$BIN/wallpaper-on-start"

if [ -f "$CONFIG_DIR/config" ]; then
    echo "! Config already exists at $CONFIG_DIR/config — skipping"
    echo "  Check config in this repo for reference"
else
    cp config "$CONFIG_DIR/config"
    echo "✓ Config copied — edit $CONFIG_DIR/config before running"
fi

echo "✓ Installed wallpaper-picker and wallpaper-on-start to $BIN"
echo "Please check and configure the config file on $CONFIG_DIR"
